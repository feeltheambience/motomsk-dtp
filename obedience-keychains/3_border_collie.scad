// Брелок №3 — бордер-колли с апорт-гантелью
// Слои: основа (цвет 1) -> собака (цвет 2) -> отметины, гантель, кличка (цвет 3 / как основа).
include <common.scad>

/* [Текст] */
NAME = "RIO";          // кличка на планке под лапами
/* [Опции] */
MARKINGS = true;       // белые отметины бордер-колли (проточина, воротник, грудь, лапы, кончик хвоста)
/* [Размеры, мм] */
BASE_H  = 2.6;         // толщина основы
DOG_H   = 1.2;         // рельеф собаки
TOP_H   = 0.6;         // отметины/гантель/кличка поверх
OUTLINE = 1.8;         // окантовка основы вокруг силуэта
HOLE_D  = 4.2;

DOG = [
 [59.4,32.3],[59,31],[58.4,30.6],[55,29.6],[51.5,28.2],[48,26.5],[47.6,24],[46.8,20.5],[45.4,17.5],
 [46.5,12],[48.5,4],[51,2.5],[51,0.5],[46.5,0.5],[46,2.5],[43.8,11],
 [42.5,14],[41.5,8],[41.8,2.2],[43.5,0.5],[38.5,0.5],[38.6,8],[38,14],
 [33,13.5],[26,14],[22,15.5],[21,9],[21.5,3],[23.5,1.5],[23.5,0.5],
 [18.5,0.5],[18.3,6],[17,11],[15,12],
 [12,6],[9.5,2.5],[10,0.5],[5.5,0.5],[6,2.5],[7.5,8],[8.5,14],[8.5,16],
 [6.5,15],[5,11.5],[4,8],[3,6.5],[1.8,7],[1.2,9.5],[2,13.5],[4.5,18],[8,21.5],
 [11,23.5],[18,24.5],[28,24.8],[35,26],[38,28.5],[40.5,31.5],[42,34.5],
 [42.2,37],[43.2,40.5],[45.2,40.2],[45.5,38.6],[47.5,38.2],[50,37.2],[51.5,35.6],
 [55,34.2],[58.3,33.2]
];

module dog_2d() { polygon(DOG); }

// апорт-гантель в пасти, видна чуть под углом
// перекладина поперёк пасти, блины сверху и снизу морды
module dumbbell_2d() {
    translate([53, 29.2]) rotate(-82) {
        square([10, 1.8], center = true);
        for (s = [-1, 1]) translate([s * 5, 0]) rrect(3, 6.4, 1);
    }
}
EYE_POS = [47.9, 35.9];

module markings_2d() {
    intersection() {
        dog_2d();
        union() {
            polygon([[49.6,38.8],[50.8,38.8],[52.5,35],[60,33.8],[60,30],[55.5,30]]); // проточина и морда
            polygon([[36.5,27],[40,32.5],[48,28.5],[48,24],[44,21.5]]);            // воротник
            polygon([[42,23],[48,23],[48,15],[41,13]]);                            // грудь
            translate([0, 0]) square([60, 4.2]);                               // «носочки»
            translate([0, 0]) square([5.2, 11]);                               // кончик хвоста
        }
    }
}

NAME_W = 52;
NAME_Y = -6;
EYE = [25, 30];

module base_2d() {
    offset(r = OUTLINE) { dog_2d(); dumbbell_2d(); }
    translate([29, NAME_Y]) rrect(NAME_W + 4, 11, 3);
    hull() { translate(EYE) circle(d = 9); translate([EYE[0], 24]) circle(d = 9); }
}

module keychain() {
    difference() {
        union() {
            linear_extrude(BASE_H) base_2d();
            color("black") translate([0, 0, BASE_H - 0.01]) linear_extrude(DOG_H)
                difference() { union() { dog_2d(); dumbbell_2d(); } translate(EYE_POS) circle(d = 1.6); }
            color("white") translate([0, 0, BASE_H + DOG_H - 0.02]) linear_extrude(TOP_H) {
                dumbbell_2d();
                if (MARKINGS) difference() { markings_2d(); translate(EYE_POS) circle(d = 2.6); }
            }
            color("white") translate([29, NAME_Y, BASE_H - 0.01])
                linear_extrude(DOG_H + TOP_H) label(NAME, NAME_W - 4, 7);
        }
        translate([EYE[0], EYE[1], -1]) cylinder(d = HOLE_D, h = 10);
    }
}

keychain();
